# Copy to .env.local and fill in. Never commit .env.local. Add the same values to Vercel →
# Project → Settings → Environment Variables.

# Public by design (they reach the browser). Supabase → Connect (or Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets: never prefix them with NEXT_PUBLIC_.
# Supabase → Connect → "Transaction pooler" connection string (port 6543), with your
# database password in place of [YOUR-PASSWORD].
DATABASE_URL=
# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which plan the Gemini key is on: free (the default; costs show as "free tier") or paid.
# GEMINI_TIER=free

# The Supabase secret / service_role key is not used. Don't add it anywhere.
