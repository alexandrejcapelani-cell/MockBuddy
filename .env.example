# Copy to .env.local and fill in. Never commit .env.local.
# ANTHROPIC_API_KEY and SUPABASE_SERVICE_ROLE_KEY are server-only: never prefix them with NEXT_PUBLIC_.

ANTHROPIC_API_KEY=
# Supabase Postgres connection string.
#   .env.local (your machine, also used by `npm run db:migrate`): Session pooler, port 5432
#   Vercel:                                                       Transaction pooler, port 6543
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USER_ID=demo
