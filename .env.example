# Copy to .env.local and fill in. Never commit .env.local.
# Server-only secret: never prefix it with NEXT_PUBLIC_.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which plan that key is on: free (the default; costs show as "free tier") or paid
# (costs are estimated from list prices in lib/ai/pricing.ts).
# GEMINI_TIER=free

# For deploying later (Supabase + Vercel). Locally, `npm run dev` starts an embedded
# database and keeps uploads in .data/, so leave these unset.
# DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# DEMO_USER_ID=demo
